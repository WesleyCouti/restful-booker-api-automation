{
  "name": "restful-booker-api-automation",
  "version": "1.0.0",
  "private": true,
  "description": "REST API test automation framework using TypeScript, Jest, SuperTest, JSON Schema validation and GitHub Actions.",
  "scripts": {
    "test": "jest --runInBand",
    "test:smoke": "jest --runInBand --testNamePattern=smoke",
    "test:regression": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:ci": "jest --runInBand --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.3",
    "ajv": "^8.17.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
